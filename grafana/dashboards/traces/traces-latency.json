{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Grafana Tempo (or Jaeger) datasource for distributed traces",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "tempo", "name": "Tempo", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "nodeGraph", "name": "Node Graph", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "End-to-end distributed tracing latency for the hslee service. Shows P50/P95/P99 latency per HTTP endpoint, request throughput, error rate, and recent traces.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "P50, P95, and P99 request duration per HTTP route derived from trace spans. Requires Tempo span-metrics pipeline or TraceQL metrics.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Latency",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max", "p95"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (http_route, le) (rate(traces_spanmetrics_duration_seconds_bucket{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p50 {{http_route}}",
          "range": true,
          "refId": "P50"
        },
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (http_route, le) (rate(traces_spanmetrics_duration_seconds_bucket{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p95 {{http_route}}",
          "range": true,
          "refId": "P95"
        },
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (http_route, le) (rate(traces_spanmetrics_duration_seconds_bucket{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p99 {{http_route}}",
          "range": true,
          "refId": "P99"
        }
      ],
      "title": "Request Latency Percentiles by Endpoint (P50 / P95 / P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "P95 latency — snapshot over the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_duration_seconds_bucket{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "instant": true,
          "legendFormat": "p95",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "P95 Latency (all routes)",
      "type": "stat"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "P99 latency — snapshot over the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_duration_seconds_bucket{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "instant": true,
          "legendFormat": "p99",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "P99 Latency (all routes)",
      "type": "stat"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "Requests per second derived from span count.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 5 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "req/s",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "Percentage of server spans with status_code = STATUS_CODE_ERROR.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 5 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "100 * sum(rate(traces_spanmetrics_calls_total{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_calls_total{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "error %",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "Requests per second broken down by HTTP route.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "sum by (http_route) (rate(traces_spanmetrics_calls_total{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request Rate by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "Error rate per HTTP route over time.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "expr": "sum by (http_route) (rate(traces_spanmetrics_calls_total{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum by (http_route) (rate(traces_spanmetrics_calls_total{service=\"hslee\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error Rate by Endpoint",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Traces",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "Recent traces from the hslee service. Click a trace ID to open the full trace timeline.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "filters": [
            { "id": "service-name", "operator": "=", "scope": "resource", "tag": "service.name", "value": ["hslee"] },
            { "id": "span-name", "operator": "=~", "scope": "span", "tag": "name", "value": ["${endpoint}"] }
          ],
          "limit": 20,
          "queryType": "nativeSearch",
          "refId": "A",
          "serviceName": "hslee",
          "spanName": "${endpoint}"
        }
      ],
      "title": "Recent Traces",
      "type": "traces"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 103,
      "title": "Latency Distribution",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "description": "Top 20 slowest traces in the selected time window.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 80 }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "ns" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100000000 }, { "color": "red", "value": 500000000 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [{ "id": "links", "value": [{ "title": "Open trace", "url": "/explore?left={\"datasource\":\"${datasource}\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"${datasource}\"},\"queryType\":\"traceql\",\"query\":\"${__value.raw}\"}],\"range\":{\"from\":\"now-1h\",\"to\":\"now\"}}" }] }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "limit": 20,
          "queryType": "traceql",
          "query": "{resource.service.name=\"hslee\" && span.kind=server} | select(duration, name, resource.service.name) | sort(duration desc)",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Slowest Traces (Top 20)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "traceID": "Trace ID",
              "traceName": "Operation",
              "startTime": "Start Time",
              "duration": "Duration",
              "serviceName": "Service"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["tracing", "opentelemetry", "hslee", "latency"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "type": "datasource",
        "label": "Tracing Datasource"
      },
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "tempo", "uid": "${datasource}" },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "endpoint",
        "options": [],
        "query": {
          "query": "span.http.route",
          "queryType": "label_values"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Endpoint"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "hslee — Distributed Tracing & Latency",
  "uid": "hslee-traces-latency",
  "version": 1,
  "weekStart": ""
}
